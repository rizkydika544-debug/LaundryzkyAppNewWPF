<Window x:Class="LaundryzkyWPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Laundryzky - Login" Height="600" Width="900"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">
    <Grid>
        <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource CardBorder}" Padding="35">
            <StackPanel VerticalAlignment="Center">
                <!-- Logo & Brand Header -->
                <TextBlock Text="🧺 Laundryzky" FontSize="26" FontWeight="Bold" 
                           Foreground="{StaticResource PrimaryBlueBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Sistem Manajemen Laundry Terintegrasi" FontSize="13" 
                           Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,25"/>

                <!-- Username -->
                <TextBlock Text="Username" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DarkTextBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="txtUsername" Style="{StaticResource ModernTextBox}" KeyDown="Input_KeyDown"/>

                <!-- Password -->
                <TextBlock Text="Password" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DarkTextBrush}" Margin="0,15,0,6"/>
                <PasswordBox x:Name="txtPassword" Style="{StaticResource ModernPasswordBox}" KeyDown="Input_KeyDown"/>

                <!-- Error text -->
                <TextBlock x:Name="lblError" Text="Username atau Password salah!" Foreground="{StaticResource DangerBrush}" 
                           FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0" Visibility="Collapsed"/>

                <!-- Role Guide Info Box -->
                <Border Background="{StaticResource LightBlueBrush}" CornerRadius="8" Padding="10" Margin="0,15,0,0">
                    <TextBlock Text="Tersedia role: Admin, Kasir, Bagian Cuci, dan Bagian Setrika." 
                               FontSize="11" Foreground="{StaticResource PrimaryBlueBrush}" TextWrapping="Wrap"/>
                </Border>

                <!-- Login Button -->
                <Button x:Name="btnLogin" Content="Masuk ke Aplikasi" Height="42" Margin="0,20,0,0" 
                        Style="{StaticResource PrimaryButton}" Click="BtnLogin_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
