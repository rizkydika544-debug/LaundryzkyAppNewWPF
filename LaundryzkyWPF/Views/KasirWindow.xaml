<Window x:Class="LaundryzkyWPF.Views.KasirWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Laundryzky - Kasir POS" Height="780" Width="1240"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Kasir -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryBlueBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Margin="20,25,20,25">
                    <TextBlock Text="🧺 Laundryzky" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <Border Background="#2563EB" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,6,0,0">
                        <TextBlock Text="KASIR POS" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </StackPanel>

                <!-- Sidebar Menus -->
                <StackPanel Grid.Row="1">
                    <Button x:Name="btnMenuKasirPOS" Content="🛒 Kasir POS (Order)" Style="{StaticResource SidebarButton}" Click="BtnMenuKasirPOS_Click"/>
                    <Button x:Name="btnMenuDaftarTransaksi" Content="🧾 Riwayat Transaksi" Style="{StaticResource SidebarButton}" Click="BtnMenuDaftarTransaksi_Click"/>
                    <Button x:Name="btnMenuPelanggan" Content="👥 Data Pelanggan" Style="{StaticResource SidebarButton}" Click="BtnMenuPelanggan_Click"/>
                </StackPanel>

                <!-- User profile & Logout -->
                <StackPanel Grid.Row="2" Margin="15,20">
                    <Border Background="#0F3796" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="lblNamaKasir" Text="Nama Kasir" FontWeight="Bold" Foreground="White" FontSize="14"/>
                            <TextBlock Text="Petugas Kasir" Foreground="#BFDBFE" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Button Content="🚪 Logout" Style="{StaticResource SecondaryButton}" Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="25,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="lblHeaderTitle" Text="Kasir Point of Sales" FontSize="20" FontWeight="Bold" Foreground="{StaticResource DarkTextBrush}"/>
                        <TextBlock Text="Input transaksi laundry baru, kelola pelanggan, dan pembayaran" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="lblTanggal" Text="Senin, 01 Januari 2026" HorizontalAlignment="Right" VerticalAlignment="Center" 
                               FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"/>
                </Grid>
            </Border>

            <!-- POS Panel Content -->
            <Grid x:Name="panelPOS" Grid.Row="1" Margin="25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Input Order Card -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,15,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Form Input Order Laundry" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,0,0,15"/>

                            <!-- Pelanggan -->
                            <TextBlock Text="Pilih Pelanggan" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="cmbPelanggan" Grid.Column="0" Height="38" DisplayMemberPath="NamaPelanggan" SelectedValuePath="IdPelanggan" SelectionChanged="CmbPelanggan_SelectionChanged"/>
                                <Button Grid.Column="1" Content="+ Pelanggan Baru" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="BtnTambahPelangganBaru_Click"/>
                            </Grid>

                            <!-- Layanan -->
                            <TextBlock Text="Jenis Layanan" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="cmbLayanan" Height="38" DisplayMemberPath="NamaLayanan" SelectedValuePath="IdLayanan" SelectionChanged="CmbLayanan_SelectionChanged" Margin="0,0,0,15"/>

                            <!-- Berat & Estimasi -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Berat (Kg) - Maks. 50 Kg" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtBerat" Style="{StaticResource ModernTextBox}" Text="1" 
                                             PreviewTextInput="NumberOnly_PreviewTextInput" 
                                             TextChanged="TxtBerat_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Estimasi Selesai" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <DatePicker x:Name="dpEstimasi" Height="38"/>
                                </StackPanel>
                            </Grid>

                            <!-- Catatan Barang / Saku Awal -->
                            <TextBlock Text="Catatan Bawaan / Cek Awal Kasir" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtCatatanKasir" Style="{StaticResource ModernTextBox}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,15"/>

                            <!-- Opsi Waktu Pembayaran -->
                            <TextBlock Text="Waktu Pembayaran" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <RadioButton x:Name="rbBayarSekarang" Content="Bayar Sekarang (Lunas)" IsChecked="True" Margin="0,0,20,0" VerticalAlignment="Center" Checked="RbOpsiBayar_Changed"/>
                                <RadioButton x:Name="rbBayarNanti" Content="Bayar Saat Ambil" VerticalAlignment="Center" Checked="RbOpsiBayar_Changed"/>
                            </StackPanel>

                            <!-- Metode Pembayaran (Cash / QRIS) -->
                            <StackPanel x:Name="panelMetodeBayar" Margin="0,0,0,15">
                                <TextBlock Text="Metode Pembayaran" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="rbMetodeTunai" Content="💵 Tunai (Cash)" IsChecked="True" Margin="0,0,20,0" VerticalAlignment="Center" Checked="RbMetodeBayar_Changed"/>
                                    <RadioButton x:Name="rbMetodeQris" Content="📱 QRIS (All Payment)" VerticalAlignment="Center" Checked="RbMetodeBayar_Changed"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Info QRIS Box (Tampil saat pilih QRIS) -->
                            <Border x:Name="borderQrisInfo" Background="#F0FDF4" BorderBrush="#22C55E" BorderThickness="1.5" CornerRadius="8" Padding="12" Margin="0,0,0,15" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Gambar QRIS Asli yang Bisa Di-Scan Smartphone (Bisa diklik untuk memperbesar) -->
                                    <Border Grid.Column="0" Background="White" BorderBrush="#22C55E" BorderThickness="2" CornerRadius="8" Padding="4" Margin="0,0,12,0" 
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="QrisImage_Click"
                                            ToolTip="Klik gambar ini untuk memperbesar QRIS agar mudah di-scan!">
                                        <Grid>
                                            <Image Source="/Assets/qris_laundry.png" Width="135" Height="190" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <Border Background="#CC000000" CornerRadius="4" VerticalAlignment="Bottom" Padding="4,2" Margin="2">
                                                <TextBlock Text="🔍 Klik Perbesar" FontSize="9.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,6">
                                            <TextBlock Text="● QRIS SIMULASI AKTIF (BISA DI-SCAN)" FontWeight="Bold" FontSize="10" Foreground="#15803D"/>
                                        </Border>
                                        <TextBlock Text="RIZKY DIKA SYAHREZA, LAUNDRY" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                        <TextBlock Text="NMID: ID1026607199175" FontSize="10" Foreground="#64748B" Margin="0,1,0,6"/>
                                        <TextBlock Text="Kamera HP / E-Wallet (GoPay, OVO, DANA, BCA, Mandiri, BRI, dll) dapat langsung scan barcode." FontSize="11" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        <TextBlock Text="👉 Klik pada gambar QRIS untuk memperbesar layar penuh!" FontSize="10.5" FontWeight="SemiBold" Foreground="#16A34A" Margin="0,0,0,6"/>
                                        <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,2,0,0">
                                            <TextBlock Text="💡 Tagihan di aplikasi Laundryzky otomatis tercatat LUNAS tanpa perlu uang tunai." FontSize="10.5" Foreground="#92400E" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Nominal Bayar -->
                            <StackPanel x:Name="panelInputBayar">
                                <TextBlock Text="Jumlah Uang Diterima (Rp)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox x:Name="txtUangBayar" Style="{StaticResource ModernTextBox}" Text="0" 
                                         PreviewTextInput="DigitsOnly_PreviewTextInput" 
                                         TextChanged="TxtUangBayar_TextChanged" Margin="0,0,0,20"/>
                            </StackPanel>

                            <!-- Action Buttons -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Reset Form" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Click="BtnReset_Click"/>
                                <Button Grid.Column="1" Content="💾 Simpan Transaksi" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="BtnSimpanTransaksi_Click"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Live Struk / Summary Card -->
                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header Struk -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,15">
                            <TextBlock Text="STRUK TRANSAKSI" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Laundryzky Bersih &amp; Terpercaya" FontSize="11" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                            <Rectangle Height="1" Fill="#CBD5E1" Margin="0,10,0,0"/>
                        </StackPanel>

                        <!-- Body Struk -->
                        <StackPanel Grid.Row="1" Margin="0,10">
                            <Grid Margin="0,4">
                                <TextBlock Text="Pelanggan:" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="lblStrukPelanggan" Text="-" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <TextBlock Text="Layanan:" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="lblStrukLayanan" Text="-" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <TextBlock Text="Tarif per Kg:" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="lblStrukTarif" Text="Rp 0" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <TextBlock Text="Berat Cucian:" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="lblStrukBerat" Text="0 Kg" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Rectangle Height="1" Fill="#E2E8F0" Margin="0,10"/>
                            <Grid Margin="0,4">
                                <TextBlock Text="Total Tagihan:" FontSize="14" FontWeight="Bold" Foreground="{StaticResource DarkTextBrush}"/>
                                <TextBlock x:Name="lblStrukTotal" Text="Rp 0" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <TextBlock Text="Metode Pembayaran:" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="lblStrukMetode" Text="Tunai (Cash)" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <TextBlock Text="Bayar (Tunai/QRIS):" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="lblStrukBayar" Text="Rp 0" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <TextBlock Text="Kembalian:" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="lblStrukKembali" Text="Rp 0" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>

                        <!-- Footer Struk -->
                        <Border Grid.Row="2" Background="{StaticResource LightBlueBrush}" CornerRadius="8" Padding="12">
                            <TextBlock Text="Cucian akan langsung masuk antrean untuk diproses oleh bagian pencucian dan setrika." FontSize="11" Foreground="{StaticResource PrimaryBlueBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Riwayat Transaksi Panel -->
            <Grid x:Name="panelDaftarTransaksi" Grid.Row="1" Margin="25" Visibility="Collapsed">
                <Border Style="{StaticResource CardBorder}" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Semua Riwayat Transaksi Laundry" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DarkTextBrush}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBox x:Name="txtCariTrx" Width="220" Height="34" Margin="0,0,10,0" Style="{StaticResource ModernTextBox}"
                                         Tag="Cari kode TRX / pelanggan..." TextChanged="TxtCariTrx_TextChanged"/>
                                <Button Content="🔄 Segarkan" Width="95" Height="34" Style="{StaticResource SecondaryButton}" Click="BtnRefreshTrx_Click"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid x:Name="dgvRiwayatTrx" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" 
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  BorderThickness="0" Background="White" RowHeight="38">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Kode TRX" Binding="{Binding KodeTransaksi}" Width="100"/>
                                <DataGridTextColumn Header="Pelanggan" Binding="{Binding NamaPelanggan}" Width="140"/>
                                <DataGridTextColumn Header="Tanggal" Binding="{Binding TanggalMasuk, StringFormat={}{0:dd-MM-yyyy}}" Width="100"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalFormatted}" Width="110"/>
                                <DataGridTextColumn Header="Status Pengerjaan" Binding="{Binding StatusDisplay}" Width="120"/>
                                <DataGridTextColumn Header="Pembayaran" Binding="{Binding StatusPembayaranDisplay}" Width="110"/>
                                <DataGridTextColumn Header="Status Cuci" Binding="{Binding StatusCuciDisplay}" Width="100"/>
                                <DataGridTextColumn Header="Status Setrika" Binding="{Binding StatusSetrikaDisplay}" Width="100"/>
                                <DataGridTextColumn Header="Catatan Saku" Binding="{Binding CatatanSaku}" Width="*"/>
                                <DataGridTemplateColumn Header="Aksi" Width="240">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Tombol Bayar / Ambil Cucian -->
                                                <Button Content="💳 Bayar / Ambil" Height="28" Width="105" Margin="0,0,6,0" Padding="6,2" FontSize="11" FontWeight="SemiBold" 
                                                        Style="{StaticResource SuccessButton}" Click="BtnBayarAmbilRiwayat_Click"/>
                                                <!-- Tombol Cetak Nota -->
                                                <Button Content="📄 Nota" Height="28" Width="65" Padding="6,2" FontSize="11" 
                                                        Style="{StaticResource PrimaryButton}" Click="BtnCetakNotaRiwayat_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Pelanggan Panel -->
            <Grid x:Name="panelPelanggan" Grid.Row="1" Margin="25" Visibility="Collapsed">
                <Border Style="{StaticResource CardBorder}" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Data Pelanggan Laundry" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DarkTextBrush}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBox x:Name="txtCariPelanggan" Width="220" Height="34" Margin="0,0,10,0" Style="{StaticResource ModernTextBox}"
                                         Tag="Cari nama / HP pelanggan..." TextChanged="TxtCariPelanggan_TextChanged"/>
                                <Button Content="+ Tambah Pelanggan" Width="150" Height="34" Style="{StaticResource PrimaryButton}" Click="BtnTambahPelangganBaru_Click"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid x:Name="dgvPelanggan" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" 
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  BorderThickness="0" Background="White" RowHeight="38">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding IdPelanggan}" Width="60"/>
                                <DataGridTextColumn Header="Nama Pelanggan" Binding="{Binding NamaPelanggan}" Width="200"/>
                                <DataGridTextColumn Header="No. HP / WA" Binding="{Binding NoHp}" Width="150"/>
                                <DataGridTextColumn Header="Alamat" Binding="{Binding Alamat}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Modal Overlay Pop-up QRIS Membesar (Di Tengah Layar Penuh) -->
        <Grid x:Name="modalQrisZoom" Grid.ColumnSpan="2" Grid.RowSpan="2" Background="#D90F172A" Visibility="Collapsed">
            <Border Background="White" CornerRadius="16" Padding="25" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#3B82F6" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5" Color="Black"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <!-- Header Pop-up -->
                    <Grid Width="460" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="SCAN QRIS PEMBAYARAN" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueBrush}"/>
                            <TextBlock Text="Arahkan kamera smartphone atau aplikasi e-wallet Anda ke barcode di bawah:" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                        <Button Content="✕" Width="32" Height="32" FontWeight="Bold" FontSize="16" Style="{StaticResource SecondaryButton}" 
                                HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnTutupModalQris_Click"
                                ToolTip="Tutup Tampilan QRIS"/>
                    </Grid>

                    <!-- Gambar QRIS Besar & Jelas -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="12" Padding="12" HorizontalAlignment="Center">
                        <Image Source="/Assets/qris_laundry.png" Width="360" Height="500" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <!-- Footer Pop-up -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button Content="Tutup QRIS (Selesai Scan)" Width="200" Height="40" Style="{StaticResource PrimaryButton}" Click="BtnTutupModalQris_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Modal Overlay Pelunasan & Pengambilan Cucian di Riwayat Transaksi -->
        <Grid x:Name="modalPelunasan" Grid.ColumnSpan="2" Grid.RowSpan="2" Background="#D90F172A" Visibility="Collapsed">
            <Border Background="White" CornerRadius="16" Padding="25" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#10B981" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.4" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Header Modal Pelunasan -->
                    <Grid Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock x:Name="lblModalPelunasanTitle" Text="Pelunasan &amp; Pengambilan Cucian" FontSize="18" FontWeight="Bold" Foreground="#047857"/>
                            <TextBlock x:Name="lblModalPelunasanSub" Text="Selesaikan pembayaran cucian saat pelanggan mengambil pakaian" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                        <Button Content="✕" Width="32" Height="32" FontWeight="Bold" FontSize="16" Style="{StaticResource SecondaryButton}" 
                                HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnBatalPelunasan_Click"/>
                    </Grid>

                    <!-- Info Ringkasan Cucian -->
                    <Border Background="#F1F5F9" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                        <StackPanel>
                            <Grid Margin="0,3">
                                <TextBlock Text="Kode Transaksi:" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="lblModalKodeTrx" Text="TRX-0001" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Pelanggan:" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="lblModalPelanggan" Text="-" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Layanan:" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="lblModalLayanan" Text="-" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Status Pengerjaan:" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="lblModalStatusPengerjaan" Text="Selesai" FontWeight="Bold" Foreground="#047857" HorizontalAlignment="Right"/>
                            </Grid>
                            <Rectangle Height="1" Fill="#CBD5E1" Margin="0,6"/>
                            <Grid Margin="0,3">
                                <TextBlock Text="Total Tagihan:" FontSize="13" FontWeight="Bold"/>
                                <TextBlock x:Name="lblModalTotalTagihan" Text="Rp 0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Status Pembayaran:" FontWeight="SemiBold"/>
                                <TextBlock x:Name="lblModalStatusBayar" Text="Belum Lunas" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Form Input Pelunasan (Jika Belum Lunas) -->
                    <StackPanel x:Name="panelInputPelunasan">
                        <TextBlock Text="Pilih Metode Pembayaran:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton x:Name="rbModalTunai" Content="💵 Tunai (Cash)" IsChecked="True" Margin="0,0,20,0" Checked="RbModalMetode_Changed"/>
                            <RadioButton x:Name="rbModalQris" Content="📱 QRIS (All Payment)" Checked="RbModalMetode_Changed"/>
                        </StackPanel>

                        <!-- QRIS Banner dalam Modal Pelunasan -->
                        <Border x:Name="borderModalQris" Background="#F0FDF4" BorderBrush="#22C55E" BorderThickness="1.5" CornerRadius="8" Padding="10" Margin="0,0,0,12" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="White" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,0,10,0" Cursor="Hand" MouseLeftButtonDown="QrisImage_Click">
                                    <Image Source="/Assets/qris_laundry.png" Width="80" Height="110" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Scan QRIS Pelanggan" FontWeight="Bold" FontSize="12" Foreground="#15803D"/>
                                    <TextBlock Text="Minta pelanggan scan barcode di samping via GoPay, BCA, OVO, DANA, dll." FontSize="10.5" Foreground="#334155" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                    <TextBlock Text="* Nominal otomatis pas sesuai total tagihan." FontSize="10" FontStyle="Italic" Foreground="#16A34A"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Input Uang Bayar Tunai -->
                        <StackPanel x:Name="panelModalInputUang" Margin="0,0,0,12">
                            <TextBlock Text="Jumlah Uang Diterima (Rp):" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtModalUangBayar" Style="{StaticResource ModernTextBox}" Text="0" 
                                     PreviewTextInput="DigitsOnly_PreviewTextInput" TextChanged="TxtModalUangBayar_TextChanged"/>
                            <Grid Margin="0,6,0,0">
                                <TextBlock Text="Kembalian:" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="lblModalKembali" Text="Rp 0" FontWeight="Bold" Foreground="#047857" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Batal" Height="38" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}" Click="BtnBatalPelunasan_Click"/>
                        <Button x:Name="btnSimpanPelunasan" Grid.Column="1" Content="✓ Lunasi &amp; Serahkan" Height="38" Margin="6,0,0,0" Style="{StaticResource SuccessButton}" Click="BtnSimpanPelunasan_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
