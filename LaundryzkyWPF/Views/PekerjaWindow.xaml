<Window x:Class="LaundryzkyWPF.Views.PekerjaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Laundryzky - Stasiun Pengerjaan Pekerja" Height="760" Width="1200"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryBlueBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Margin="20,25,20,25">
                    <TextBlock Text="🧺 Laundryzky" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <Border Background="#2563EB" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,6,0,0">
                        <TextBlock x:Name="txtRoleBadge" Text="STASIUN PEKERJA" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </StackPanel>

                <!-- Menu navigation -->
                <StackPanel Grid.Row="1">
                    <Button x:Name="btnMenuPekerjaan" Content="⚙️ Tugas Saya" Style="{StaticResource SidebarButton}" Click="BtnMenuPekerjaan_Click"/>
                    <Button x:Name="btnMenuSemuaProgres" Content="📋 Monitor Semua Progres" Style="{StaticResource SidebarButton}" Click="BtnMenuSemuaProgres_Click"/>
                </StackPanel>

                <!-- User profile & Logout -->
                <StackPanel Grid.Row="2" Margin="15,20">
                    <Border Background="#0F3796" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="lblNamaUser" Text="Nama Pekerja" FontWeight="Bold" Foreground="White" FontSize="14"/>
                            <TextBlock x:Name="lblRoleDetail" Text="Bagian Pencucian" Foreground="#BFDBFE" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Button Content="🚪 Logout" Style="{StaticResource SecondaryButton}" Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="25,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="lblHeaderTitle" Text="Daftar Antrean &amp; Pengerjaan" FontSize="20" FontWeight="Bold" Foreground="{StaticResource DarkTextBrush}"/>
                        <TextBlock x:Name="lblHeaderDesc" Text="Proses cucian dan kelola catatan barang bawaan/saku pelanggan" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="lblTanggal" Text="Senin, 01 Januari 2026" HorizontalAlignment="Right" VerticalAlignment="Center" 
                               FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"/>
                </Grid>
            </Border>

            <!-- Main Panel Content -->
            <Grid Grid.Row="1" Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Responsibility / Rule Banner & Mode Bar -->
                <Border Grid.Row="0" Background="{StaticResource LightBlueBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,15">
                    <Grid>
                        <StackPanel Margin="0,0,260,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="🛡️ Status Mode: " FontWeight="Bold" Foreground="{StaticResource PrimaryBlueBrush}" FontSize="13"/>
                                <TextBlock x:Name="lblModeInfo" Text="Menampilkan Tugas Stasiun Anda" FontWeight="Bold" Foreground="#1E3A8A" FontSize="13"/>
                            </StackPanel>
                            <TextBlock x:Name="txtRoleNotice" Text="1. Petugas pencucian bertanggung jawab mencatat barang di saku/pakaian yang tertinggal. 2. Anda dapat melihat progres bagian setrika, tetapi tidak dapat mengubah status pengerjaan setrika." 
                                       FontSize="12" Foreground="{StaticResource DarkTextBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBox x:Name="txtCariTugas" Width="190" Height="34" Margin="0,0,10,0" Style="{StaticResource ModernTextBox}"
                                     Tag="Cari TRX / pelanggan..." TextChanged="TxtCariTugas_TextChanged"/>
                            <Button Content="🔄 Refresh Data" Width="110" Height="34"
                                    Style="{StaticResource SecondaryButton}" Click="BtnRefresh_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Data Table -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="15">
                    <DataGrid x:Name="dgvTugas" AutoGenerateColumns="False" CanUserAddRows="False" 
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="DgvTugas_SelectionChanged"
                              BorderThickness="0" Background="White" RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kode TRX" Binding="{Binding KodeTransaksi}" Width="100"/>
                            <DataGridTextColumn Header="Pelanggan" Binding="{Binding NamaPelanggan}" Width="150"/>
                            <DataGridTextColumn Header="Layanan" Binding="{Binding NamaLayanan}" Width="120"/>
                            <DataGridTextColumn Header="Berat" Binding="{Binding BeratKg, StringFormat={}{0} Kg}" Width="80"/>
                            <DataGridTextColumn Header="Status Cuci" Binding="{Binding StatusCuciDisplay}" Width="110"/>
                            <DataGridTextColumn Header="Petugas Cuci" Binding="{Binding PetugasCuci}" Width="130"/>
                            <DataGridTextColumn Header="Status Setrika" Binding="{Binding StatusSetrikaDisplay}" Width="110"/>
                            <DataGridTextColumn Header="Petugas Setrika" Binding="{Binding PetugasSetrika}" Width="130"/>
                            <DataGridTextColumn Header="Catatan Saku / Barang" Binding="{Binding CatatanSaku}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Bottom Action & Pocket Log Panel -->
                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="18" Margin="0,15,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Pocket/Responsibility Log Input -->
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="📝 Catatan Barang Bawaan / Ketinggalan di Saku (Tanggung Jawab Pemegang Cucian):" 
                                       FontWeight="Bold" FontSize="13" Foreground="{StaticResource DarkTextBrush}"/>
                            <TextBox x:Name="txtCatatanSaku" Style="{StaticResource ModernTextBox}" Height="36" Margin="0,6,0,0"
                                     ToolTip="Contoh: Ada uang 50rb di saku celana kanan, struk belanja, kunci motor, dsb."/>
                        </StackPanel>

                        <!-- Workflow Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button x:Name="btnSimpanCatatan" Content="💾 Simpan Catatan Saku" Height="38" Margin="0,0,10,0" 
                                    Style="{StaticResource SecondaryButton}" Click="BtnSimpanCatatan_Click"/>
                            <Button x:Name="btnAmbilTugas" Content="🧺 Ambil &amp; Mulai Pengerjaan" Height="38" Margin="0,0,10,0" 
                                    Style="{StaticResource PrimaryButton}" Click="BtnAmbilTugas_Click"/>
                            <Button x:Name="btnSelesaiTugas" Content="✅ Tandai Selesai" Height="38" 
                                    Style="{StaticResource SuccessButton}" Click="BtnSelesaiTugas_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
