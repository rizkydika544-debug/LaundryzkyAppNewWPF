<Window x:Class="LaundryzkyWPF.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Laundryzky - Administrator Panel" Height="800" Width="1280"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryBlueBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Margin="20,25,20,25">
                    <TextBlock Text="🧺 Laundryzky" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <Border Background="#2563EB" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,6,0,0">
                        <TextBlock Text="ADMINISTRATOR" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </StackPanel>

                <!-- Navigation Links -->
                <StackPanel Grid.Row="1">
                    <Button x:Name="btnMenuBeranda" Content="🏠 Beranda" Style="{StaticResource SidebarButton}" Click="BtnMenuBeranda_Click"/>
                    <Button x:Name="btnMenuKelolaUser" Content="⚙️ Kelola Karyawan &amp; Role" Style="{StaticResource SidebarButton}" Click="BtnMenuKelolaUser_Click"/>
                    <Button x:Name="btnMenuSemuaTrx" Content="🧾 Transaksi &amp; Alur Kerja" Style="{StaticResource SidebarButton}" Click="BtnMenuSemuaTrx_Click"/>
                    <Button x:Name="btnMenuLaporan" Content="📊 Laporan Keuangan" Style="{StaticResource SidebarButton}" Click="BtnMenuLaporan_Click"/>
                </StackPanel>

                <!-- Profile & Logout -->
                <StackPanel Grid.Row="2" Margin="15,20">
                    <Border Background="#0F3796" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="lblNamaAdmin" Text="Admin Laundryzky" FontWeight="Bold" Foreground="White" FontSize="14"/>
                            <TextBlock Text="Administrator" Foreground="#BFDBFE" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Button Content="🚪 Logout" Style="{StaticResource SecondaryButton}" Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="25,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="lblHeaderTitle" Text="Kelola Karyawan &amp; Pembagian Role" FontSize="20" FontWeight="Bold" Foreground="{StaticResource DarkTextBrush}"/>
                        <TextBlock x:Name="lblHeaderDesc" Text="Tambah dan atur hak akses user: Kasir, Bagian Cuci, dan Bagian Setrika" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="lblTanggal" Text="Senin, 01 Januari 2026" HorizontalAlignment="Right" VerticalAlignment="Center" 
                               FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"/>
                </Grid>
            </Border>

            <!-- Panel Kelola User (Karyawan & Hak Akses) -->
            <Grid x:Name="panelKelolaUser" Grid.Row="1" Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Action Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Daftar Pengguna / Karyawan" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DarkTextBrush}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBox x:Name="txtCariUser" Width="200" Height="34" Margin="0,0,10,0" Style="{StaticResource ModernTextBox}"
                                 Tag="Cari nama/username..." TextChanged="TxtCariUser_TextChanged"/>
                        <Button Content="🔄 Refresh" Width="95" Height="34" Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" Click="BtnRefreshUser_Click"/>
                        <Button Content="+ Tambah User" Height="34" Padding="15,0" Style="{StaticResource PrimaryButton}" Click="BtnTambahUser_Click"/>
                    </StackPanel>
                </Grid>

                <!-- DataGrid User -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="15">
                    <DataGrid x:Name="dgvUser" AutoGenerateColumns="False" CanUserAddRows="False" 
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" Background="White" RowHeight="42">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdUser}" Width="50"/>
                            <DataGridTextColumn Header="Nama Karyawan" Binding="{Binding NamaUser}" Width="180"/>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="140"/>
                            <DataGridTextColumn Header="Role / Bagian" Binding="{Binding RoleDisplay}" Width="150"/>
                            <DataGridTextColumn Header="Status Akun" Binding="{Binding StatusDisplay}" Width="120"/>
                            <DataGridTemplateColumn Header="Aksi" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Edit" Height="28" Padding="10,2" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Click="BtnEditUser_Click"/>
                                            <Button Content="Ubah Status (Aktif/Nonaktif)" Height="28" Padding="10,2" Style="{StaticResource SecondaryButton}" Click="BtnToggleStatusUser_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- Panel Beranda / Statistik -->
            <Grid x:Name="panelBeranda" Grid.Row="1" Margin="25" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Summary Cards -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Total Transaksi" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock x:Name="lblStatTotalTrx" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="18" Margin="5,0,5,0">
                        <StackPanel>
                            <TextBlock Text="Sedang Dikerjakan" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock x:Name="lblStatDiproses" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="18" Margin="5,0,5,0">
                        <StackPanel>
                            <TextBlock Text="Selesai Siap Ambil" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock x:Name="lblStatSelesai" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource CardBorder}" Padding="18" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Total Pendapatan" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock x:Name="lblStatPendapatan" Text="Rp 0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="18">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Selamat Datang di Panel Administrator Laundryzky" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Sistem telah terbagi otomatis sesuai role: Kasir hanya input order, Pekerja Cuci &amp; Setrika fokus pengerjaan &amp; cek saku pakaian." 
                                   FontSize="13" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Panel Monitor Semua Transaksi -->
            <Grid x:Name="panelSemuaTrx" Grid.Row="1" Margin="25" Visibility="Collapsed">
                <Border Style="{StaticResource CardBorder}" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Semua Transaksi &amp; Pelacakan Petugas" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DarkTextBrush}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBox x:Name="txtCariSemuaTrx" Width="240" Height="34" Margin="0,0,10,0" Style="{StaticResource ModernTextBox}"
                                         Tag="Cari kode TRX/pelanggan/petugas..." TextChanged="TxtCariSemuaTrx_TextChanged"/>
                                <Button Content="🔄 Segarkan" Width="95" Height="34" Style="{StaticResource SecondaryButton}" Click="BtnRefreshSemuaTrx_Click"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid x:Name="dgvSemuaTrx" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" 
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  BorderThickness="0" Background="White" RowHeight="38">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Kode TRX" Binding="{Binding KodeTransaksi}" Width="90"/>
                                <DataGridTextColumn Header="Pelanggan" Binding="{Binding NamaPelanggan}" Width="130"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalFormatted}" Width="100"/>
                                <DataGridTextColumn Header="Status Pengerjaan" Binding="{Binding StatusDisplay}" Width="120"/>
                                <DataGridTextColumn Header="Status Cuci" Binding="{Binding StatusCuciDisplay}" Width="100"/>
                                <DataGridTextColumn Header="Petugas Cuci" Binding="{Binding PetugasCuci}" Width="120"/>
                                <DataGridTextColumn Header="Status Setrika" Binding="{Binding StatusSetrikaDisplay}" Width="100"/>
                                <DataGridTextColumn Header="Petugas Setrika" Binding="{Binding PetugasSetrika}" Width="120"/>
                                <DataGridTextColumn Header="Catatan Saku" Binding="{Binding CatatanSaku}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Panel Laporan Keuangan -->
            <Grid x:Name="panelLaporan" Grid.Row="1" Margin="25" Visibility="Collapsed">
                <Border Style="{StaticResource CardBorder}" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Dari:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <DatePicker x:Name="dtpDari" Width="130" Height="34" Margin="0,0,15,0"/>
                                <TextBlock Text="Sampai:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <DatePicker x:Name="dtpSampai" Width="130" Height="34" Margin="0,0,15,0"/>
                                <Button Content="Tampilkan Laporan" Height="34" Padding="12,0" Style="{StaticResource PrimaryButton}" Click="BtnFilterLaporan_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBox x:Name="txtCariLaporan" Width="180" Height="34" Margin="0,0,8,0" Style="{StaticResource ModernTextBox}"
                                         Tag="Cari pelanggan/TRX..." TextChanged="TxtCariLaporan_TextChanged"/>
                                <Button Content="📥 Ekspor Excel (CSV)" Height="34" Padding="12,0" Margin="0,0,8,0" 
                                        Background="#10B981" Foreground="White" Style="{StaticResource PrimaryButton}" Click="BtnEksporCsv_Click"/>
                                <Button Content="📄 Cetak Laporan (PDF)" Height="34" Padding="12,0" Margin="0,0,8,0" Style="{StaticResource SuccessButton}" Click="BtnCetakLaporanPdf_Click"/>
                                <Button Content="🗑️ Reset Transaksi &amp; Pelanggan" Height="34" Padding="10,0" 
                                         Background="#FEE2E2" Foreground="#991B1B" Style="{StaticResource SecondaryButton}" Click="BtnResetDatabase_Click"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid x:Name="dgvLaporan" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" 
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  BorderThickness="0" Background="White" RowHeight="38">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Kode TRX" Binding="{Binding KodeTransaksi}" Width="100"/>
                                <DataGridTextColumn Header="Pelanggan" Binding="{Binding NamaPelanggan}" Width="150"/>
                                <DataGridTextColumn Header="Tgl Masuk" Binding="{Binding TanggalMasuk, StringFormat={}{0:dd-MM-yyyy}}" Width="110"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalFormatted}" Width="110"/>
                                <DataGridTextColumn Header="Status Bayar" Binding="{Binding StatusPembayaranDisplay}" Width="110"/>
                                <DataGridTextColumn Header="Status Pengerjaan" Binding="{Binding StatusDisplay}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
