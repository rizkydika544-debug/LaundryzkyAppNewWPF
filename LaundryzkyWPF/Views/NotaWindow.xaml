<Window x:Class="LaundryzkyWPF.Views.NotaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nota Transaksi - Laundryzky" 
        SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Area Nota Kertas Cetak -->
        <Border x:Name="borderNota" Grid.Row="0" Background="White" CornerRadius="8" Padding="25"
                BorderBrush="#CBD5E1" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="2" Opacity="0.08" Color="Black"/>
            </Border.Effect>
            <StackPanel x:Name="panelKertasNota">
                    <!-- Header Nota -->
                    <TextBlock Text="🧺 LAUNDRYZKY" FontSize="20" FontWeight="Bold" Foreground="#1A56C4" HorizontalAlignment="Center"/>
                    <TextBlock Text="Sistem Manajemen Laundry Terintegrasi" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <TextBlock Text="Jl. Laundry Bersih No. 123 | WA: 0812-3456-7890" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,10"/>

                    <Rectangle Height="1" Fill="#94A3B8" Margin="0,5,0,10"/>

                    <!-- Info Transaksi -->
                    <Grid Margin="0,2">
                        <TextBlock Text="No. Transaksi" FontSize="11" Foreground="#64748B"/>
                        <TextBlock x:Name="lblNoTrx" Text="TRX-0001" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <TextBlock Text="Tanggal Masuk" FontSize="11" Foreground="#64748B"/>
                        <TextBlock x:Name="lblTanggalMasuk" Text="24-10-2026" FontSize="11" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <TextBlock Text="Estimasi Selesai" FontSize="11" Foreground="#64748B"/>
                        <TextBlock x:Name="lblEstimasi" Text="26-10-2026" FontSize="11" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <TextBlock Text="Kasir Melayani" FontSize="11" Foreground="#64748B"/>
                        <TextBlock x:Name="lblKasir" Text="Rizky" FontSize="11" HorizontalAlignment="Right"/>
                    </Grid>

                    <Rectangle Height="1" StrokeDashArray="2,2" Stroke="#CBD5E1" Margin="0,10"/>

                    <!-- Data Pelanggan -->
                    <TextBlock Text="DATA PELANGGAN:" FontWeight="Bold" FontSize="11" Foreground="#1A56C4" Margin="0,0,0,4"/>
                    <Grid Margin="0,2">
                        <TextBlock Text="Nama Pelanggan" FontSize="11" Foreground="#64748B"/>
                        <TextBlock x:Name="lblNamaPelanggan" Text="Budi Santoso" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <TextBlock Text="No. WhatsApp / HP" FontSize="11" Foreground="#64748B"/>
                        <TextBlock x:Name="lblNoHp" Text="081298765432" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>

                    <Rectangle Height="1" StrokeDashArray="2,2" Stroke="#CBD5E1" Margin="0,10"/>

                    <!-- Rincian Cucian -->
                    <TextBlock Text="RINCIAN LAYANAN:" FontWeight="Bold" FontSize="11" Foreground="#1A56C4" Margin="0,0,0,4"/>
                    <Grid Margin="0,2">
                        <TextBlock x:Name="lblNamaLayanan" Text="Cuci Kering + Setrika" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="lblTarif" Text="Rp 8.000 /Kg" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <TextBlock Text="Berat Cucian" FontSize="11" Foreground="#64748B"/>
                        <TextBlock x:Name="lblBerat" Text="3.5 Kg" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>

                    <Rectangle Height="1" Fill="#94A3B8" Margin="0,10"/>

                    <!-- Total & Pembayaran -->
                    <Grid Margin="0,3">
                        <TextBlock Text="Total Tagihan" FontSize="13" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock x:Name="lblTotal" Text="Rp 28.000" FontSize="15" FontWeight="Bold" Foreground="#1A56C4" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <TextBlock Text="Metode Pembayaran" FontSize="11" Foreground="#64748B"/>
                        <TextBlock x:Name="lblMetodeBayar" Text="Tunai" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <TextBlock Text="Status Pembayaran" FontSize="11" Foreground="#64748B"/>
                        <Border x:Name="bdStatusBayar" Background="#DEF7EC" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                            <TextBlock x:Name="lblStatusBayar" Text="LUNAS" FontWeight="Bold" FontSize="11" Foreground="#03543F"/>
                        </Border>
                    </Grid>
                    <Grid Margin="0,2">
                        <TextBlock Text="Nominal Bayar" FontSize="11" Foreground="#64748B"/>
                        <TextBlock x:Name="lblBayar" Text="Rp 30.000" FontSize="11" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <TextBlock Text="Kembalian" FontSize="11" Foreground="#64748B"/>
                        <TextBlock x:Name="lblKembali" Text="Rp 2.000" FontSize="11" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Right"/>
                    </Grid>

                    <Rectangle Height="1" Fill="#CBD5E1" Margin="0,10"/>

                    <!-- Catatan Kasir / Saku -->
                    <TextBlock Text="Catatan Bawaan / Saku:" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock x:Name="lblCatatan" Text="-" FontSize="10" FontStyle="Italic" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,10"/>

                    <!-- Footer Note -->
                    <Border Background="#F8FAFC" CornerRadius="6" Padding="8" Margin="0,5,0,0">
                        <TextBlock Text="* Harap membawa struk nota ini saat pengambilan pakaian. Cucian yang tidak diambil lebih dari 30 hari di luar tanggung jawab kami." 
                                   FontSize="9" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Border>
                </StackPanel>
        </Border>

        <!-- Tombol Cetak & Simpan PDF -->
        <Grid Grid.Row="1" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Tutup" Height="38" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}" Click="BtnTutup_Click"/>
            <Button Grid.Column="1" Content="💾 Simpan PDF / Cetak" Height="38" Margin="6,0,0,0" Style="{StaticResource PrimaryButton}" Click="BtnCetak_Click"/>
        </Grid>
    </Grid>
</Window>
