<Window x:Class="LaundryzkyWPF.Views.TambahPelangganWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tambah Pelanggan Baru" Height="420" MaxHeight="520" Width="440"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">
    <Grid Margin="15">
        <Border Style="{StaticResource CardBorder}" Padding="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="5">
                    <TextBlock Text="Tambah Pelanggan Baru" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,0,0,15"/>

                    <TextBlock Text="Nama Pelanggan" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtNamaPelanggan" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                    <TextBlock Text="No. HP / WhatsApp (Angka saja)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtNoHp" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                             PreviewTextInput="NoHp_PreviewTextInput"/>

                    <TextBlock Text="Alamat Lengkap" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtAlamat" Style="{StaticResource ModernTextBox}" Height="65" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,20"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Batal" Height="40" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}" Click="BtnBatal_Click"/>
                        <Button Grid.Column="1" Content="Simpan" Height="40" Margin="6,0,0,0" Style="{StaticResource PrimaryButton}" Click="BtnSimpan_Click"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
